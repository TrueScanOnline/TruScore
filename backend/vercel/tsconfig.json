{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node", "@vercel/node"],
    "noEmit": false,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true
  },
  "include": [
    "api/**/*",
    "data/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "extends": null
}

