{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "types": ["node", "@vercel/node"]
  },
  "include": ["api/**/*", "lib/**/*", "data/**/*", "types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "lib/database.ts",
    "lib/databaseNeon.ts",
    "api/user-prices.ts"
  ]
}
