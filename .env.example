# Copy to `.env` for local secrets (never commit real `.env`).
# Non-secret Dynamic Signals flags for Expo Go are in committed `.env.development`.

# Vercel API base (no trailing slash). Used for manual-products, share telemetry, etc.
# Must match the project you deploy from `backend/vercel` (e.g. after `vercel --prod`).
EXPO_PUBLIC_BACKEND_URL=https://truscoreapi.vercel.app

# Dynamic Signals (also defaulted in `.env.development` + app.config.js for local Metro)
# EXPO_PUBLIC_DYNAMIC_SIGNALS_ASSET=1
# EXPO_PUBLIC_FOOD_RECALL_CORRECTED_PATH=1
# EXPO_PUBLIC_WORKSTREAMC_SKELETON_UAT=0
