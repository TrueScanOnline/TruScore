{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "src/*": ["src/*"]
    }
  },
  "include": ["*.ts", "global.d.ts", "../global.d.ts", "../src/**/*"]
}

