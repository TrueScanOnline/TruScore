{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "baseUrl": "..",
    "paths": {
      "src/*": ["src/*"]
    },
    "types": ["node"],
    "jsx": "react",
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["*.ts", "global.d.ts", "../global.d.ts", "../src/**/*"],
  "exclude": ["../node_modules/**/*", "../app/**/*"],
  "ts-node": {
    "transpileOnly": true,
    "skipIgnore": false,
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node",
      "skipLibCheck": true
    }
  }
}

