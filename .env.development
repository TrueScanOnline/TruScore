# Loaded automatically by Expo for local development (Expo Go / Metro).
# Non-secret MVP flags only — do not put API keys here.
# Secrets stay in gitignored `.env`.

EXPO_PUBLIC_DYNAMIC_SIGNALS_ASSET=1
EXPO_PUBLIC_FOOD_RECALL_CORRECTED_PATH=1
EXPO_PUBLIC_WORKSTREAMC_SKELETON_UAT=0
# Acceptance guard only. Does not stamp evidence. Expo Go matches the UAT authority.
EXPO_PUBLIC_EVIDENCE_AUTHORITY_ENV=uat
# Same host as the UAT EAS profiles. The production API does not serve this authority.
EXPO_PUBLIC_BACKEND_URL=https://truscoreapi-uat.vercel.app
# Public Share Product Link host (temporary). Contribution/EA stay on UAT backend above.
EXPO_PUBLIC_SHARE_WEB_ORIGIN=https://truscoreapi.vercel.app
# Closed pre-launch visual UAT only. Not a rights grant. Store profiles set this to 0.
EXPO_PUBLIC_CLOSED_PRELAUNCH_VISUAL_UAT=1
# Local/UAT only: restore guided Contribution + WP09 UI against the UAT host above.
# Store/EAS profiles keep these at 0 (app.config.js / eas.json production-default OFF).
# Do not set these to 1 with a production authority or store release profile.
EXPO_PUBLIC_MVP_GUIDED_CONTRIBUTION=1
EXPO_PUBLIC_MVP_COMMUNITY_AGREEMENTS=1
