{
  "name": "truescan-food-scanner",
  "version": "1.0.0",
  "private": true,
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "scripts": {
    "verify-backend": "ts-node --project scripts/tsconfig.json scripts/verify-backend-config.ts",
    "verify-off": "ts-node --project scripts/tsconfig.json scripts/verify-off-submission.ts",
    "check-vercel-env": "powershell -ExecutionPolicy Bypass -File scripts/check-vercel-env.ps1",
    "check-vercel-env:strict": "powershell -ExecutionPolicy Bypass -File scripts/check-vercel-env.ps1 -RequirePhotoCdn",
    "test:user-contributions": "jest src/__tests__/integration/userContribution.test.ts",
    "test:user-contributions-e2e": "jest src/__tests__/integration/userContributionE2E.test.ts",
    "test:user-contributions-script": "ts-node --project scripts/tsconfig.json scripts/test-user-contributions-e2e.ts",
    "test:all-data-entry": "ts-node --project scripts/tsconfig.json scripts/test-all-data-entry-e2e.ts",
    "test:full-e2e": "powershell -ExecutionPolicy Bypass -File scripts/run-full-e2e-test.ps1",
    "analyze-truscore": "ts-node --project scripts/tsconfig.json scripts/analyze-truscore-standalone.ts",
    "analyze-truscore:ps1": "powershell -ExecutionPolicy Bypass -File scripts/run-truscore-analysis.ps1",
    "analyze-pillar": "ts-node --project scripts/tsconfig.json scripts/analyze-pillar.ts",
    "extract-bbfaw2024": "ts-node --project scripts/tsconfig.json scripts/extractBBFAW2024FromDocx.ts",
    "extract-bbfaw-mapping": "ts-node --project scripts/tsconfig.json scripts/extractBBFAWMappingExcel.ts",
    "extract-ktc-mapping": "ts-node --project scripts/tsconfig.json scripts/extractKTCMappingExcel.ts",
    "sync-ethics-data": "ts-node --project scripts/tsconfig.json scripts/syncEthicsPillarData.ts",
    "ethics-pillar:refresh": "npm run extract-bbfaw2024 && npm run extract-bbfaw-mapping && npm run sync-ethics-data",
    "test:barcode-performance": "ts-node --project scripts/tsconfig.json scripts/testBarcodePerformance.ts",
    "test:barcode-performance:ps1": "powershell -ExecutionPolicy Bypass -File scripts/testBarcodePerformance.ps1",
    "test:pillar:body": "jest src/__tests__/unit/lib/pillars/bodyPillar.test.ts",
    "test:pillar:planet": "jest src/__tests__/unit/lib/pillars/planetPillar.test.ts",
    "test:pillar:ethics": "jest src/__tests__/unit/lib/pillars/ethicsPillar.test.ts",
    "test:pillar:open": "jest src/__tests__/unit/lib/pillars/openPillar.test.ts",
    "test:pillars": "jest src/__tests__/unit/lib/pillars/",
    "test:e2e:ethics-open-backend": "ts-node --project scripts/tsconfig.json scripts/e2eEthicsOpenBackendVerification.ts",
    "test:e2e:user-submission-cards": "ts-node --project scripts/tsconfig.json scripts/e2e-user-submission-cards.ts",
    "test:csv-database": "jest src/__tests__/unit/services/csvDatabaseService.test.ts",
    "test": "jest",
    "setup-backend": "powershell -ExecutionPolicy Bypass -File scripts/setup-backend.ps1",
    "setup-backend:env": "powershell -ExecutionPolicy Bypass -File scripts/configure-vercel-env.ps1",
    "setup-backend:complete": "powershell -ExecutionPolicy Bypass -File scripts/complete-backend-setup.ps1",
    "setup-backend:env-vars": "powershell -ExecutionPolicy Bypass -File scripts/add-vercel-env-vars.ps1",
    "setup-backend:final": "powershell -ExecutionPolicy Bypass -File scripts/add-env-and-redeploy.ps1",
    "redeploy-backend": "powershell -ExecutionPolicy Bypass -File scripts/redeploy-backend.ps1",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "doctor": "expo-doctor",
    "build:apk": "eas build -p android --profile preview",
    "build:ios": "eas build -p ios --profile preview",
    "build:aab": "eas build -p android --profile production",
    "import-fsanz": "node scripts/importFSANZDatabase.js",
    "download-fsanz": "node scripts/downloadAndConvertFSANZ.js",
    "populate-fsanz": "node scripts/populateFSANZFromOpenFoodFacts.js",
    "import-nzfcd": "node scripts/importNZFCDToSQLite.js",
    "import-afcd": "node scripts/importAFCDToSQLite.js",
    "convert-fsanz": "node scripts/convertFSANZToJSON.js",
    "setup-fsanz-hosting": "node scripts/setupFSANZHosting.js",
    "setup-fsanz": "node scripts/completeFSANZSetup.js",
    "vercel-login": "powershell -ExecutionPolicy Bypass -File scripts/vercelLogin.ps1",
    "deploy-fsanz": "powershell -ExecutionPolicy Bypass -File scripts/completeFSANZDeployment.ps1",
    "audit": "npm audit --production",
    "audit:fix": "npm audit fix",
    "lint": "eslint app src backend/vercel/api backend/vercel/lib backend/vercel/types --ext .ts,.tsx",
    "lint:ci": "eslint app src backend/vercel/api backend/vercel/lib backend/vercel/types --ext .ts,.tsx",
    "lint:fix": "eslint app src backend/vercel/api backend/vercel/lib backend/vercel/types --ext .ts,.tsx --fix",
    "lint:all": "eslint . --ext .ts,.tsx",
    "lint:fix:all": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.8.5",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.24",
    "@react-navigation/stack": "^7.1.7",
    "@sentry/react-native": "~6.14.0",
    "expo": "~53.0.27",
    "expo-build-properties": "~0.14.8",
    "expo-camera": "^16.1.11",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-image": "~2.4.1",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-location": "~18.1.6",
    "expo-navigation-bar": "~4.2.8",
    "expo-secure-store": "~14.2.4",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "i18next": "^24.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^15.1.1",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-maps": "1.20.1",
    "react-native-qonversion": "^9.0.3",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "zod": "^4.1.12",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "better-sqlite3": "^12.4.6",
    "cheerio": "^1.2.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "mammoth": "^1.11.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "xlsx": "^0.18.5"
  },
  "resolutions": {
    "react-native": "0.79.6"
  },
  "packageManager": "yarn@1.22.19"
}
