workstreamA/a-data/smoke-pack-v0/

# Workstream B smoke output (regenerated by npm run workstreamB:smoke)
workstreamB/b-data/smoke-pack-v0/

# Regenerated scaffold outputs (inputs remain tracked)
workstreamB/b-data/template-v0/output/
