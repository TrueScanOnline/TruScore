# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Microsoft Office lock files (not real documents)
~$*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# API keys and secrets (never commit)
Database files/API keys/
**/API keys/

# typescript
*.tsbuildinfo

# EAS
.eas/

# Test data files
barcode_*.json
*_TEST_RESULTS.json
*.test-results.json
API_TEST_RESULTS.json# Temporary build command files
BUILD_*.txt
COPY_*.txt
RUN_*.txt
SUBMIT_*.txt
*_NOW.txt# Temporary analysis scripts output
analyze_*.json
test-results-*.json

# Local scratch / one-off extraction (do not ship)
.tmp_*
.vercel
.env*.local

